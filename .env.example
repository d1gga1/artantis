# Copia questo file, rinominalo ".env.local" e incolla i tuoi due valori Supabase.
# Li trovi in: Supabase → il tuo progetto → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=incolla-qui-la-chiave-anon-public

# Indirizzo ufficiale del sito (senza barra finale).
# Serve a Google e ai social per costruire i collegamenti assoluti.
# In produzione va lasciato su https://artantiss.com
NEXT_PUBLIC_SITE_URL=https://artantiss.com
